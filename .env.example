# The Marketer API credentials
# Copy this file to `.env` and fill in your real values.

# Required
THEMARKETER_CUSTOMER_ID=your-customer-id
THEMARKETER_REST_KEY=your-rest-key

# Required only for tracking-based events
THEMARKETER_TRACKING_KEY=your-tracking-key

# Optional overrides (defaults shown)
THEMARKETER_REST_URL=https://t.themarketer.com
THEMARKETER_TRACKING_URL=https://t.themarketer.com
THEMARKETER_MAX_RETRY_ATTEMPTS=1
